{#
    Couverture d'un livre.
    - Si une image a été téléversée (livre.couverture), elle est affichée.
    - Sinon, une couverture illustrée façon grimoire relié de cuir est dessinée;
      sa teinte est choisie dans la palette selon l'identifiant du livre.
    Utilisation :
        {% import 'partials/couverture.php.twig' as illustration %}
        {{ illustration.couverture(livre) }}
        {{ illustration.couverture(livre, true) }}   (grande version)
#}
{% macro couverture(livre, grande = false) %}
    {% set teintes = ['#5C0F1A', '#2E3B2A', '#1E1A2B', '#3B1230', '#4A1942', '#7A1E2B', '#3A2A1E'] %}
    {% set teinte = teintes[(livre.id|default(0)) % teintes|length] %}
    {% set image = livre.couverture|default(null) %}

    <div class="couverture{{ grande ? ' couverture--grande' }}{{ image ? ' couverture--image' }}" style="--couleur: {{ teinte }};" aria-hidden="true">
        {% if image %}
            <img src="{{ base }}/uploads/couvertures/{{ image }}" alt="" loading="lazy">
        {% endif %}
        <span class="couverture__titre">{{ livre.titre }}</span>
        <span class="couverture__auteur">{{ livre.auteur_nom|default('') }}</span>
    </div>
{% endmacro %}
